#include <stdio.h>
 
int main() {

char caracteres[10];

int letraAscii[10];
 


printf("-Ingreso de los 10 caracteres\n");

    for (int i = 0; i < 10; i++) {

        printf("Introduce el caracter %d: ", i + 1);

        scanf("%c", &caracteres[i]); 

    }
 
printf("\n Caracteres introducidos\n");

    for (int i = 0; i < 10; i++) {

        printf("%c ", caracteres[i]);

    }

    printf("\n");

for (int i = 0; i < 10; i++) {

    letraAscii[i] = (int)caracteres[i];

    }
 
printf("\n Codigos ASCII guardados \n");

    for (int i = 0; i < 10; i++) {

        printf("%d ", letraAscii[i]);

    }

    printf("\n");
 
    return 0;

}

 
