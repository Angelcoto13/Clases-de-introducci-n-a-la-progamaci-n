#include <stdio.h>
#include <stdlib.h>
 
    float areaCirculo(float radio){

    float area = 3.1416 * (radio * radio);

    return area;

    }
 
    float areaTriangulo(float base, float altura){

    float area = base * altura / 2;

    return area;

    }

    float areaRectangulo(float base, float altura){

     float area = base * altura;

    return area;

}
 
 
