#include <stdio.h>


int main() {
      int altura, a, b, c;

    printf("Introduce la altura de tuu piramide: ");
    scanf("%d", &altura);

    printf("Tu piramide:\n");

    for (a = 1; a <= altura; a++) {
        
        for (b = 1; b <= altura - a; b++) {
            printf(" ");
        }

        for (c = 1; c <= (2 * a - 1); c++) {
            printf("*");
        }

        printf("\n");
    } 

    return 0;
}
