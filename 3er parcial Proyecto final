#include <stdio.h>

#include <stdlib.h>
 
#define SIZE 3

#define TOTALCULTIVOS 3
 
void inicializarGranja(char matriz[SIZE][SIZE]){

    for(int i = 0; i < SIZE; i++){

        for(int j = 0; j < SIZE; j++) {

            matriz[i][j] = '~'; 

        }

    }

}
 
void mostrarGranjaDetallada(char granja[SIZE][SIZE], int diasActuales[SIZE][SIZE], char regado[SIZE][SIZE], int tiempoCrecimiento[]){

    printf("     0               1               2       \n");

    for(int i = 0; i < SIZE; i++){

        printf("%d  ", i);

        for(int j = 0; j < SIZE; j++) {

            if (granja[i][j] == '~') {

                printf("[  ~  ]     ");

            } else {

                char tipo = granja[i][j];

                int id = -1;

                if (tipo == 'T') id = 0;

                if (tipo == 'M') id = 1;

                if (tipo == 'Z') id = 2;

                char estadoRiego = (regado[i][j] == 'W') ? '+' : ' ';

                printf("[ %c (%d/%d)%c ]    ", tipo, diasActuales[i][j], tiempoCrecimiento[id], estadoRiego);

            }

        }

        printf("\n");

    }

    printf("\n* Nota: (+) significa que ya fue regado hoy. Las plantas solo crecen si se riegan.\n\n");

}
 
int main(){

    char granja[SIZE][SIZE];       

    char regado[SIZE][SIZE];       

    inicializarGranja(granja);

    inicializarGranja(regado);
 
    char nombres[TOTALCULTIVOS] = {'T', 'M', 'Z'};

    int costos[TOTALCULTIVOS] = {10, 20, 15};

    int precios[TOTALCULTIVOS] = {30, 55, 40};

    int tiempoCrecimiento[TOTALCULTIVOS] = {2, 3, 2};
 
    int diasActuales[SIZE][SIZE];

    for(int i=0; i<SIZE; i++) {

        for(int j=0; j<SIZE; j++) diasActuales[i][j] = 0;

    }
 
    int dinero = 100;

    int agua = 10;

    int semillasTomate = 2;

    int semillasMaiz = 2;

    int semillasZanahoria = 2;

    int diaActual = 1;

    int juegoTerminado = 0;
 
    while (!juegoTerminado) {

        int opcion;

        printf(".......................................\n");

        printf(" Granjas el Pollon - DÍA %d \n", diaActual);

        printf("________________________________________\n");

        printf("Dinero: $%d  |  Agua: %d unidades\n", dinero, agua);

        printf("Semillas disponibles = Tomate (0): %d | Maíz (1): %d | Zanahoria (2): %d\n", semillasTomate, semillasMaiz, semillasZanahoria);

        printf("..................................................... \n");

        printf("Estado de la granjita:\n");

        mostrarGranjaDetallada(granja, diasActuales, regado, tiempoCrecimiento);
 
        printf("Menú de opciones:\n");

        printf("1. Sembrar cultivo\n");

        printf("2. Regar terreno\n");

        printf("3. Cosechar y vender\n");

        printf("4. Avanzar al siguiente día\n");

        printf("5. Salir de la granja\n");

        printf("Selecciona una opción: ");

        scanf("%d", &opcion);
 
        int r, c;
 
        

        switch (opcion) {

            case 1:

                printf("Ingresa coordenadas para sembrar (Fila Columna): ");

                scanf("%d %d", &r, &c);

                if (r >= 0 && r < SIZE && c >= 0 && c < SIZE) {

                    if (granja[r][c] != '~') {

                        printf("Este terreno ya esta ocupado krnal pulpo!\n");

                    } else {

                        int tipo;

                        printf("¿Que deseas sembrar? (0: Tomate, 1: Maíz, 2: Zanahoria): ");

                        scanf("%d", &tipo);

                        if (tipo == 0 && semillasTomate > 0) {

                            granja[r][c] = 'T';

                            semillasTomate--;

                            diasActuales[r][c] = 0;

                            printf("Tomate sembrado!\n");

                        } else if (tipo == 1 && semillasMaiz > 0) {

                            granja[r][c] = 'M';

                            semillasMaiz--;

                            diasActuales[r][c] = 0;

                            printf("Maiz sembrado!\n");

                        } else if (tipo == 2 && semillasZanahoria > 0) {

                            granja[r][c] = 'Z';

                            semillasZanahoria--;

                            diasActuales[r][c] = 0;

                            printf("Zanahoria sembrada!\n");

                        } else {

                            printf("Opcion invalida o no tienes semillas de ese tipo.\n");

                        }

                    }

                } else {

                    printf("Coordenadas fuera de rango.\n");

                }

                break;
 
            case 2:

                printf("Ingresa coordenadas a regar (Fila Columna): ");

                scanf("%d %d", &r, &c);

                if (r >= 0 && r < SIZE && c >= 0 && c < SIZE) {

                    if (granja[r][c] == '~') {

                        printf("No hay nada sembrado aquí para regar.\n");

                    } else if (regado[r][c] == 'W') {

                        printf("Esta tierrita ya fue regada el día de hoy.\n");

                    } else if (agua <= 0) {

                        printf("No tienes suficiente agua disponible.\n");

                    } else {

                        regado[r][c] = 'W'; 

                        agua--;

                        printf("Terreno regado!\n");

                        char tipo = granja[r][c];

                        int id = (tipo == 'T') ? 0 : (tipo == 'M') ? 1 : 2;

                        printf("Estado actual del cultivo en (%d,%d): %d de %d regadas completadas.\n", 

                               r, c, diasActuales[r][c], tiempoCrecimiento[id]);

                    }

                } else {

                    printf("Coordenadas fuera de rango.\n");

                }

                break;
 
            case 3:

                printf("Ingresa coordenadas para cosechar (Fila y Columna): ");

                scanf("%d %d", &r, &c);

                if (r >= 0 && r < SIZE && c >= 0 && c < SIZE) {

                    char cultivo = granja[r][c];

                    if (cultivo == '~') {

                        printf("Nada que cosechar aquí.\n");

                    } else {

                        int idCultivo = -1;

                        if (cultivo == 'T') idCultivo = 0;

                        if (cultivo == 'M') idCultivo = 1;

                        if (cultivo == 'Z') idCultivo = 2;

                        if (diasActuales[r][c] < tiempoCrecimiento[idCultivo]) {

                            printf("Accion invalida! El cultivo aún no está listo. Requiere %d regadas, lleva %d.\n", 

                                   tiempoCrecimiento[idCultivo], diasActuales[r][c]);

                        } else {

                            int ganancia = precios[idCultivo];

                            int costoBase = costos[idCultivo];

                            int rendimiento = ganancia - costoBase;

                            dinero += ganancia;

                            printf("Cosecha exitosa APAAA! vendiste el cultivo por $%d (Rendimiento: +$%d)\n", ganancia, rendimiento);

                            granja[r][c] = '~';

                            regado[r][c] = '~';

                            diasActuales[r][c] = 0;

                        }

                    }

                } else {

                    printf("Coordenadas fuera de rango.\n");

                }

                break;
 
            case 4:

                diaActual++;

                printf("\n:ooo Avanzando al siguiente dia :DDDDD Las plantas crecen si recibieron agua :3 ...\n");

                for(int i = 0; i < SIZE; i++){

                    for(int j = 0; j < SIZE; j++) {

                        if (granja[i][j] != '~') {

                            if (regado[i][j] == 'W') {

                                diasActuales[i][j]++;

                            } else {

                                printf("Kakaroto: el cultivo en (%d, %d) no creció por falta de riego.\n", i, j);

                            }

                        }

                        regado[i][j] = '~';

                    }

                }

                agua += 3; 

                break;
 
            case 5:

                printf("Gracias por jugar Bom dia ;3 \n");

                juegoTerminado = 1;

                break;
 
            default:

                printf("Opción inválida.\n");

                break;

        }
 
        if (!juegoTerminado) {

            printf("\nPresiona Enter para continuar...");

            while (getchar() != '\n');

            getchar();

            for(int i = 0; i < 30; i++) printf("\n");

        }

    }

    return 0;

}

 
