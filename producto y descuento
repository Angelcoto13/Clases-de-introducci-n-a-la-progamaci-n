#include <stdio.h>
 
int main() {

    float precio, descuento, precioFinal;
 
    printf("Ingresa el precio del producto: ");

    scanf("%f", &precio);
 
    descuento = precio * 0.23;

    precioFinal = precio - descuento;
 
    printf("\nPrecio original: $%.2f\n", precio);

    printf("Descuento aplicado: $%.2f (23%%)\n", descuento);

    printf("Precio final: $%.2f\n", precioFinal);
 
    return 0;

}
 
