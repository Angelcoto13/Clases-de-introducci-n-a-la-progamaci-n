#include <stdio.h>
    int SumarNumeros (){
        int a, b;
        printf("dame el valor de a");
        scanf("%d", &a);
        printf("dame el valor de b");
        scanf("%d", &b);
        return a + b;
    }
    int RestarNumeros (){
        int a, b;
        printf("dame el valor de a");
        scanf("%d", &a);
        printf("dame el valor de b");
        scanf("%d", &b);
        return a - b;
    }
    int MultiplicarNumeros (){
        int a, b;
        printf("dame el valor de a");
        scanf("%d", &a);
        printf("dame el valor de b");
        scanf("%d", &b);
        return a * b;
    }
    int DivisionNumeros (){
        int a, b;
        printf("dame el valor de a");
        scanf("%d", &a);
        printf("dame el valor de b");
        scanf("%d", &b);
        return a / b;
    }

 
