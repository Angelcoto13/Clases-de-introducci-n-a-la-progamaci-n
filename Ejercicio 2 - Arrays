#include <stdio.h>
 
int main() {

    float fahrenheit[5];

    float celsius[5];
 
    

    const char* dias[] = {"DiaUno", "DiaDos", "DiaTres", "DiaCuatro", "DiaCinco"};
 
    

    printf( "Ingreso de temperaturas (FAHRENHEIT)\n");

    for (int i = 0; i < 5; i++) {

        printf("Ingrese la temperatura del %s: ", dias[i]);

        scanf("%f", &fahrenheit[i]);

    }
 
  

    for (int i = 0; i < 5; i++) {

        celsius[i] = (fahrenheit[i] - 32) / 1.8;

    }
 
 
    printf("\n Tabla de temperaturas \n");

    for (int i = 0; i < 5; i++) {

        printf("%s: %.2f F  ===>  %.2f C\n", dias[i], fahrenheit[i], celsius[i]);

    }
 
   

    float maxCelsius = celsius[0];

    float minCelsius = celsius[0];

    int tempMax = 0;

    int tempMin = 0;
 
    for (int i = 1; i < 5; i++) {

        if (celsius[i] > maxCelsius) {

            maxCelsius = celsius[i];

            tempMax = i;

        }

        if (celsius[i] < minCelsius) {

            minCelsius = celsius[i];

            tempMin = i;

        }

    }
 
 
    printf("\n REPORTE DE Temperaturas \n");

    printf("El dia mas caluroso fue el %s con %.2f C\n", dias[tempMax], maxCelsius);

    printf("El dia mas frio fue el %s con %.2f C\n", dias[tempMin], minCelsius);
 
    return 0;

}
 
