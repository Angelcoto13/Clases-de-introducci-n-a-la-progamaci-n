#include <stdio.h>

    float CalcularAreaRectangulo (float base, float altura){
        float Area = base * altura;
        return Area;
}
    float CalcularPerimetroRectangulo (float base, float altura){
        float Perimetro = 2 * (base + altura);
        return Perimetro;
}

